# Necesario solo para que la tool submit_pattern pueda abrir Pull Requests.
# Token de GitHub con permisos de escritura (Contents + Pull requests) sobre
# el repo de este proyecto, idealmente un fine-grained PAT limitado solo a el.
GITHUB_TOKEN=

# Opcionales, tienen valor por defecto en el codigo:
# GITHUB_REPO=colyvoapp-cyber/vibepat
# GITHUB_BASE_BRANCH=master

# Necesario para que el agente verificador (Groq) revise las propuestas.
GROQ_API_KEY=

# Necesario para el ratio de reciprocidad (consultas vs. contribuciones).
# Base de datos Redis en Upstash (console.upstash.com), REST API.
# Sin esto configurado, find_pattern no aplica ningun limite.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
